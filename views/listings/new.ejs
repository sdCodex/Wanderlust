<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Listing</title>
  </head>
  <body>
    <% layout('/layouts/boilerplate') -%>
    <div class="row mt-3">
      <div class="col-8 offset-2">
        <h1>Create a new listing</h1>
        <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
          <div class="mb-3">
            <label for="newTitle" class="form-label">Enter Title: </label>
            <input
              type="text"
              name="listing[title]"
              id="newTitle"
              class="form-control" placeholder="Add a catchy title" required
            />

            <div class="valid-feedback">
              Title looks good!
            </div>
            <div class="invalid-feedback">
              Please enter a title
            </div>
          </div>

          <div class="mb-3">
            <label for="newDescription" class="form-label"
              >Enter Description:
            </label>
            <textarea
              name="listing[description]"
              id="newDescription"
              class="form-control" required
            ></textarea>

            <div class="invalid-feedback">
              Please enter a short description
            </div>
          </div>

          <div class="mb-3">
            <label for="newImage" class="form-label"
              >Upload Image:
            </label>
            <input
              type="file"
              name="listing[image]"
              id="newImage"
              class="form-control"  required/>
          </div>

          <div class="row">
            <div class="mb-3 col-md-4">
              <label for="newPrice" class="form-label">Enter Price: </label>
              <input
                name="listing[price]"
                id="newPrice"
                class="form-control" placeholder="1200"
                required
              />
              <div class="invalid-feedback">
                Price should be valid
              </div>
            </div>

            <div class="mb-3 col-md-8">
              <label for="newLocation" class="form-label"
                >Enter Location:
              </label>
              <input
                type="text"
                name="listing[location]"
                id="newLocation"
                class="form-control" placeholder="Jaipur,Rajasthan"
                required
              />
              <div class="invalid-feedback">
                Location should be valid
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label for="newCountry" class="form-label">Enter Country: </label>
            <input
              type="text"
              name="listing[country]"
              id="newCountry"
              class="form-control" placeholder="India"
              required
            />

            <div class="invalid-feedback">
              Country name should be valid 
            </div>
          </div>

          <button class="btn btn-dark mb-3">Add</button>
        </form>
      </div>
    </div>
    <br><br>
  </body>
</html>
