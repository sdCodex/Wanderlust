<% layout('/layouts/boilerplate') -%>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing= <%- JSON.stringify(info) %>;
  
</script>
<body>
  <div class="row">
    <div class="col-8 offset-3 mt-3">
      <h2><%= info.title %></h2>
    </div>

    <div class="card col-6 offset-3 show-card listing-card">
      <img src="<%= info.image.url %>" class="card-img-top show-img" alt="..." />
      <div class="card-body">
        <p class="card-text">Owned By: <%= info.owner.username %> </p>
        <p class="card-text"><%= info.description %> </p>
        <p class="card-text"></p>₹<%= info.price.toLocaleString("en-IN")%> </p>
        <p class="card-text"></p><%= info.location %> </p>
        <p class="card-text"></p><%= info.country%></p>
      </div>
    </div>
  </div>
  <% if(currUser && currUser._id.equals(info.owner._id)) { %> 
    <div class="btns mb-3">
      <a
        href="/listings/<%= info._id %>/edit"
        class="btn btn-dark col-1 offset-3 edit-btn"
        >Edit</a
      >

      <form
        method="post"
        action="/listings/<%= info._id %>?_method=DELETE"
        onsubmit="return confirmDelete()"
      >
        <button class="btn btn-dark offset-5">Delete</button>
      </form>
    </div>
    <% } %>   

  <% if(currUser &&  !currUser._id.equals(info.owner._id)) { %>
  <div class="col-8 offset-3 mb-3">
    <hr>
    <h4>Leave a Review</h4>
    <form method="post" action="/listings/<%= info._id %>/reviews" novalidate class="needs-validation">

      <div class="mt-3 mb-2">
        <label for="rating" class="form-label">Rating</label>
        <fieldset class="starability-slot">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div> 

    <div class="mt-3 mb-3">
      <label for="comments" class="form-label">Comments</label>
      <textarea name="review[comment]" id="comment" rows="5" cols="30" class="form-control" required></textarea>
      <div class="invalid-feedback">
        Please give your feedback
      </div>
    </div>
    <div class="mt-3">
      <button class="btn btn-outline-dark">Submit</button>
    </div>
  </form>
  </div>
 <% } %>
  <% if(info.reviews.length) { %>
  
  <div class="col-8 offset-3 mt-3 mb-3">
    <hr>
    <h5>All Reviews</h4>
    <div class="row">
      <% for(reviews of info.reviews) { %>
        <div class="card col-5 mb-3 ms-3">
          <div class="card-body">
            <h5 class="card-title">@<%=reviews.author.username %></h5>
            <p class="starability-result card-text" data-rating="<%= reviews.rating %>"></p> 
            <h6 class="card-subtitle mb-2 text-body-secondary"><%= reviews.comment %>
            </h6>
          </div>


        <% if(currUser && currUser._id.equals(reviews.author._id)) { %>  
          <form method="post" action="/listings/<%= info._id %>/reviews/<%= reviews._id %>?_method=DELETE" class="mb-3 mt-3"  onsubmit="return confirmDelete()">
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>
        <% } else {%>
          <div class="mb-5 mt-3"></div>
        <% } %>    

        </div>
      <% } %>
    </div>
  </div>
<% } %> 


<div class="col-8 offset-3 mt-3 mb-3">
  <hr>
  <h3>Where you'll be</h3>
  <div id="map"></div>
</div>




  <script>
    function confirmDelete() {
      let ans = confirm(`Are you sure you want to delete? `);
      return ans;
    }
  </script>
  
<script src="/js/map.js"></script>

</body>
