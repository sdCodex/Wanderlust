<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
</head>
<body>
    <% layout('/layouts/boilerplate') -%>

    <div class="row mt-3">
        <h3 class="col-6 offset-3 mb-3">Login</h3>
        <div class="col-6 offset-3">
          <form action="/login " method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
              <label for="username" class="form-label">Enter Username: </label>
              <input
                type="text"
                name="username"
                id="username"
                class="form-control"
                required
              />
  
            </div>


          
  
          <div class="mb-3">
              <label for="password" class="form-label">Enter Password: </label>
              <input
                type="password"
                name="password"
                id="password"
                class="form-control"
                required
              />
          </div>
  
          <button class="btn btn-dark mb-3">Login</button>
          </form>
        </div>
      </div>
</body>
</html>